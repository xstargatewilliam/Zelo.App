<Window x:Class="Zelo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Janela"
        Title="Zelo"
        Width="1180" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/zelo.ico"
        Background="{StaticResource Noite}"
        Foreground="{StaticResource Texto}"
        FontFamily="{StaticResource Fonte}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Botão que abre e fecha (detalhes, opções avançadas). -->
        <Style x:Key="BotaoAlternar" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Fundo" Background="Transparent" BorderBrush="{StaticResource LinhaForte}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource HoverForte}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource LuarClaro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão que liga e desliga (perfis de uso, escolha múltipla). -->
        <Style x:Key="CartaoAlternar" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Fundo" Background="{StaticResource Ceu}" BorderBrush="{StaticResource Linha}" BorderThickness="2" CornerRadius="12" Padding="14,12">
                            <Grid>
                                <ContentPresenter Margin="0,26,0,0"/>
                                <Border x:Name="Marca" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        BorderBrush="{StaticResource LinhaForte}" BorderThickness="2">
                                    <Path x:Name="Visto" Data="M2,6 L5,9 L10,3" Stroke="{StaticResource Noite}" StrokeThickness="2" Width="12" Height="12"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="1,1,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="#3A4560"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Luar}"/>
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter TargetName="Marca" Property="Background" Value="{StaticResource Luar}"/>
                                <Setter TargetName="Marca" Property="BorderBrush" Value="{StaticResource Luar}"/>
                                <Setter TargetName="Visto" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource LuarClaro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha de configuração com interruptor. -->
        <Style x:Key="LinhaAjuste" TargetType="Border">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BorderBrush" Value="{StaticResource Linha}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= Menu lateral ======================= -->
        <Border Grid.Column="0" Background="{StaticResource Barra}" BorderBrush="#1F2738" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,28">
                    <Image Source="Assets/zelo-256.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Zelo" FontFamily="{StaticResource FonteTitulo}" FontSize="21" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Ceu}" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <Hyperlink x:Name="LinkVersao" NavigateUri="https://github.com/xstargatewilliam/Zelo.App" RequestNavigate="Link_RequestNavigate"
                                       Foreground="{StaticResource Texto2}" TextDecorations="{x:Null}" ToolTip="Abrir o repositório no GitHub"><Run x:Name="TxtVersaoMenu" Text="Zelo"/></Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource Suave}">
                            <Run Text="Criado por "/><Hyperlink NavigateUri="https://x.com/stargaterequiem" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource Luar}" TextDecorations="{x:Null}" ToolTip="William Stargate no X">William Stargate</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavInicio" GroupName="nav" Style="{StaticResource ItemMenu}" IsChecked="True" Checked="Nav_Checked" AutomationProperties.Name="Início">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M3,11 L12,4 L21,11 L21,20 L15,20 L15,14 L9,14 L9,20 L3,20 Z"/>
                            <TextBlock Text="Início" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHistorico" GroupName="nav" Style="{StaticResource ItemMenu}" Checked="Nav_Checked" AutomationProperties.Name="Histórico">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M3,12 A9,9 0 1 0 6,5.3 L3,8 M3,3 L3,8 L8,8 M12,7 L12,12 L15,14"/>
                            <TextBlock Text="Histórico" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOtimizar" GroupName="nav" Style="{StaticResource ItemMenu}" Checked="Nav_Checked" AutomationProperties.Name="Otimizar">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M13,2 L4,14 L12,14 L11,22 L20,10 L12,10 Z"/>
                            <TextBlock Text="Otimizar" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAjustes" GroupName="nav" Style="{StaticResource ItemMenu}" Checked="Nav_Checked" AutomationProperties.Name="Ajustes">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M4,6 L14,6 M18,6 L20,6 M4,12 L8,12 M12,12 L20,12 M4,18 L16,18 M14,6 A2,2 0 1 0 18,6 A2,2 0 1 0 14,6 M8,12 A2,2 0 1 0 12,12 A2,2 0 1 0 8,12 M16,18 A2,2 0 1 0 20,18 A2,2 0 1 0 16,18"/>
                            <TextBlock Text="Ajustes" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================= Início ======================= -->
        <ScrollViewer x:Name="PaginaInicio" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConteudoInicio" Margin="40,32,40,48" MaxWidth="1160">
                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>

                <Border x:Name="BannerServico" Visibility="Collapsed" Background="{StaticResource CoralFundo}" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource TCorpo}" Foreground="{StaticResource Texto}">
                        <Run FontWeight="SemiBold" Text="O serviço do Zelo não está respondendo."/>
                        <Run Text="As vistorias automáticas dependem dele. Confira se ele está instalado e rodando (Win + R → services.msc → Zelo). O painel tenta reconectar sozinho."/>
                    </TextBlock>
                </Border>

                <Border x:Name="BannerPausa" Visibility="Collapsed" Background="{StaticResource Nuvem}" CornerRadius="10" Padding="18,6" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtPausa" Style="{StaticResource TCorpo}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Retomar agora" Style="{StaticResource BotaoLink}" Click="Retomar_Click"/>
                    </Grid>
                </Border>

                <!-- Herói: estado normal -->
                <Border x:Name="HeroNormal" Style="{StaticResource Cartao}" CornerRadius="16" Padding="28,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="132" Height="132" VerticalAlignment="Center">
                            <Ellipse Width="116" Height="116" Stroke="{StaticResource HoverForte}" StrokeThickness="12"/>
                            <Path x:Name="Arco" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource Aurora}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtScore" Text="—" FontFamily="{StaticResource FonteTitulo}" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtScoreDe" Text="de 100" FontSize="12" Foreground="{StaticResource Suave}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="28,0,24,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitulo" Text="Conectando…" Style="{StaticResource TTitulo}"/>
                            <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource TCorpo}" Margin="0,8,0,0" FontSize="15"/>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock x:Name="TxtCobertura" Style="{StaticResource TSuave}" Margin="0,0,20,0"/>
                                <TextBlock x:Name="TxtUltima" Style="{StaticResource TSuave}"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="236" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnCuidar" Content="Cuidar agora" Style="{StaticResource BotaoPrimario}" Click="Cuidar_Click"
                                        ToolTip="Faz a vistoria diária agora"/>
                                <Button x:Name="BtnMaisRotinas" Grid.Column="1" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="0" Width="44"
                                        Click="MaisRotinas_Click" AutomationProperties.Name="Outras rotinas" ToolTip="Outras rotinas">
                                    <Path Width="12" Height="8" Stretch="Uniform" Stroke="{StaticResource Texto}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L6,6 L11,1"/>
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="MenuRotinas">
                                            <MenuItem Header="Revisão semanal agora" Tag="Semanal" Click="RotinaMenu_Click"/>
                                            <MenuItem Header="Check-up mensal agora" Tag="Mensal" Click="RotinaMenu_Click"/>
                                            <MenuItem Header="Simular a revisão semanal" Tag="Semanal|sim" Click="RotinaMenu_Click"/>
                                            <MenuItem Header="Simular o check-up mensal" Tag="Mensal|sim" Click="RotinaMenu_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                            <Button x:Name="BtnSimular" Content="Simular antes (não altera nada)" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" Click="Simular_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Herói: cuidando agora -->
                <Border x:Name="HeroCuidando" Visibility="Collapsed" Style="{StaticResource Cartao}" CornerRadius="16" Padding="32,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="132" Height="132" VerticalAlignment="Center">
                            <Ellipse x:Name="Halo" Opacity="0.25">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#8EA4FF"/>
                                        <GradientStop Offset="0.7" Color="#008EA4FF"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Viewbox x:Name="Lua" Width="132" Height="132" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform><ScaleTransform x:Name="EscalaLua" ScaleX="1" ScaleY="1"/></Viewbox.RenderTransform>
                                <Canvas Width="64" Height="64">
                                    <Path Fill="{StaticResource Lua}">
                                        <Path.Data>
                                            <CombinedGeometry GeometryCombineMode="Exclude">
                                                <CombinedGeometry.Geometry1><EllipseGeometry Center="30,34" RadiusX="19" RadiusY="19"/></CombinedGeometry.Geometry1>
                                                <CombinedGeometry.Geometry2><EllipseGeometry Center="40,25" RadiusX="16.5" RadiusY="16.5"/></CombinedGeometry.Geometry2>
                                            </CombinedGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path x:Name="Estrela" Fill="#F4F6FF" Data="M47,11.5 L48.6,17.4 L54.5,19 L48.6,20.6 L47,26.5 L45.4,20.6 L39.5,19 L45.4,17.4 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="32,0,24,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRotinaRodando" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Luar}"/>
                            <TextBlock x:Name="TxtEtapaAtual" Style="{StaticResource TTitulo}" FontSize="25" Margin="0,8,0,12">
                                <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                            </TextBlock>
                            <Grid Height="8">
                                <Border Background="{StaticResource HoverForte}" CornerRadius="4"/>
                                <Border x:Name="BarraProgresso" Background="{StaticResource Luar}" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="TxtEtapaInfo" Style="{StaticResource TSuave}" Margin="0,8,0,0"/>
                            <TextBlock Text="Pode continuar usando o PC normalmente." Style="{StaticResource TCorpo}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnParar" Grid.Column="2" Content="Parar" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Top" Click="Parar_Click"/>
                    </Grid>
                </Border>

                <!-- Etapas da rotina em andamento -->
                <StackPanel x:Name="SecaoEtapas" Visibility="Collapsed">
                    <TextBlock Text="O que o Zelo está fazendo" Style="{StaticResource TSecao}"/>
                    <Border Style="{StaticResource Cartao}" Padding="0">
                        <ItemsControl x:Name="ListaEtapas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LinhaAjuste}" Padding="20,14" Background="{Binding Fundo}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                <Ellipse Fill="{Binding CorFundo}" Visibility="{Binding VisFeito}"/>
                                                <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Cor}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="{Binding Icone}" Visibility="{Binding VisFeito}"/>
                                                <Ellipse Stroke="#3A4560" StrokeThickness="2" Visibility="{Binding VisPendente}"/>
                                                <Grid Visibility="{Binding VisRodando}" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform><RotateTransform x:Name="Giro"/></Grid.RenderTransform>
                                                    <Grid.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Giro" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Grid.Triggers>
                                                    <Ellipse Stroke="{StaticResource LinhaForte}" StrokeThickness="2.5"/>
                                                    <Path Stroke="{StaticResource Luar}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,1.25 A8.75,8.75 0 0 1 18.75,10"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Nome}" FontWeight="{Binding Peso}" Foreground="{Binding CorNome}" Margin="14,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detalhe}" Foreground="{Binding CorDetalhe}" FontSize="13" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Áreas -->
                <StackPanel x:Name="SecaoAreas">
                    <TextBlock Text="Como está cada área" Style="{StaticResource TSecao}"/>
                    <ItemsControl x:Name="ListaAreas" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ColunasAreas, ElementName=Janela}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Categoria}" Click="Area_Click" Cursor="Hand" Margin="0,0,12,12" Focusable="True"
                                        AutomationProperties.Name="{Binding Nome}" ToolTip="Ver o que o Zelo verificou nesta área">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Moldura" Style="{StaticResource Cartao}" BorderBrush="{Binding Borda}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Moldura" Property="Background" Value="{StaticResource Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Moldura" Property="BorderBrush" Value="{StaticResource LuarClaro}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Cor}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{Binding Icone}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusTexto}" Foreground="{Binding Cor}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Texto}" Margin="0,8,0,4"/>
                                        <TextBlock Text="{Binding Texto}" Style="{StaticResource TSuave}"/>
                                        <TextBlock Text="Ver detalhes ›" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Luar}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Pontos de atenção -->
                <StackPanel x:Name="SecaoAtencao">
                    <TextBlock Text="Precisa da sua atenção" Style="{StaticResource TSecao}" Margin="0,16,0,12"/>
                    <TextBlock x:Name="TxtSemPontos" Text="Nada pendente. Tudo em ordem por aqui." Style="{StaticResource TCorpo}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="ListaPontos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Cartao}" Padding="20,16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{Binding CorFundo}" VerticalAlignment="Top">
                                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Cor}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{Binding Icone}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TForte}" FontSize="15"/>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource TSuave}" Margin="0,3,0,0"/>
                                            <WrapPanel Margin="0,12,0,0" Visibility="{Binding VisAcoes}">
                                                <ItemsControl ItemsSource="{Binding Acoes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Texto}" Tag="{Binding Id}" Style="{StaticResource BotaoSecundario}" MinHeight="38" FontSize="13" Padding="14,0" Margin="0,0,8,8" Click="AcaoPonto_Click"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ToggleButton Style="{StaticResource BotaoAlternar}" IsChecked="{Binding Expandido, Mode=TwoWay}" Content="{Binding TextoDetalhes}"
                                                              Visibility="{Binding VisBotaoDetalhes}" MinHeight="38" Margin="0,0,8,8" BorderThickness="0"/>
                                            </WrapPanel>
                                            <Border Visibility="{Binding VisDetalhes}" Background="{StaticResource Barra}" CornerRadius="8" Padding="14,10" Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Detalhes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="Abrir site" Tag="{Binding Link}" Visibility="{Binding VisLink}" Style="{StaticResource BotaoLink}"
                                                                        MinHeight="28" FontSize="12.5" Margin="8,0,0,0" Click="AbrirLink_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Agenda -->
                <StackPanel x:Name="SecaoAgenda">
                    <TextBlock Text="Agenda de cuidados" Style="{StaticResource TSecao}" Margin="0,16,0,12"/>
                    <Border Style="{StaticResource Cartao}" Padding="0">
                        <ItemsControl x:Name="ListaAgenda">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LinhaAjuste}" Padding="20,14" BorderThickness="{Binding Separador}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Ultima}" Foreground="{StaticResource Suave}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Proxima}" Foreground="{StaticResource Texto2}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock x:Name="TxtJanela" Style="{StaticResource TSuave}" Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================= Histórico ======================= -->
        <ScrollViewer x:Name="PaginaHistorico" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="ConteudoHistorico" Margin="40,32,40,48" MaxWidth="1160">
                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                <TextBlock Text="Histórico" Style="{StaticResource TTitulo}"/>
                <TextBlock Text="Tudo o que o Zelo verificou, encontrou e mudou — com o porquê de cada coisa." Style="{StaticResource TCorpo}" FontSize="15" Margin="0,6,0,24"/>

                <Border Style="{StaticResource Cartao}" CornerRadius="16" Padding="24,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Saúde nos últimos 30 dias" Style="{StaticResource TForte}" FontSize="16"/>
                            <TextBlock x:Name="TxtGraficoResumo" Grid.Column="1" Style="{StaticResource TSuave}" TextAlignment="Right" Margin="16,0,0,0"/>
                        </Grid>
                        <Grid Height="170" Margin="0,12,0,0">
                            <Canvas x:Name="Grafico" ClipToBounds="True" SizeChanged="Grafico_SizeChanged"/>
                            <TextBlock x:Name="TxtGraficoVazio" Text="O gráfico aparece depois das primeiras vistorias." Style="{StaticResource TSuave}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <RadioButton x:Name="FiltroTodas" GroupName="filtro" Content="Todas" Style="{StaticResource FichaRadio}" IsChecked="True" Checked="Filtro_Checked"/>
                    <RadioButton x:Name="FiltroProblemas" GroupName="filtro" Content="Só com problemas" Style="{StaticResource FichaRadio}" Checked="Filtro_Checked"/>
                    <RadioButton x:Name="FiltroSimulacoes" GroupName="filtro" Content="Simulações" Style="{StaticResource FichaRadio}" Checked="Filtro_Checked"/>
                </StackPanel>

                <TextBlock x:Name="TxtHistoricoVazio" Text="Nenhuma vistoria por aqui ainda." Style="{StaticResource TCorpo}" Margin="0,20,0,0" Visibility="Collapsed"/>

                <ItemsControl x:Name="ListaGrupos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TRotulo}" Margin="0,24,0,10"/>
                                <ItemsControl ItemsSource="{Binding Itens}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="20,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{Binding CorFundo}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusTexto}" Foreground="{Binding Cor}" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TForte}" FontSize="15"/>
                                                            <TextBlock Text="{Binding Resumo}" Style="{StaticResource TSuave}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <ToggleButton Grid.Column="2" Style="{StaticResource BotaoAlternar}" IsChecked="{Binding Expandido, Mode=TwoWay}" Content="{Binding TextoBotao}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Border Visibility="{Binding VisDetalhes}" BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Padding="20,6,20,14">
                                                        <StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Linhas}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,9">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="110"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Rotulo}" Foreground="{Binding Cor}" FontSize="13" FontWeight="SemiBold"/>
                                                                            <StackPanel Grid.Column="1">
                                                                                <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="19">
                                                                                    <Run Text="{Binding Nome, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Resumo, Mode=OneWay}" Foreground="{StaticResource Texto2}"/>
                                                                                </TextBlock>
                                                                                <ItemsControl ItemsSource="{Binding Detalhes}" Visibility="{Binding VisDetalhes}" Margin="0,4,0,0">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid Margin="0,2">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{StaticResource Suave}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                                                <Button Grid.Column="1" Content="Abrir site" Tag="{Binding Link}" Visibility="{Binding VisLink}" Style="{StaticResource BotaoLink}"
                                                                                                        MinHeight="28" FontSize="12.5" Margin="8,0,0,0" Click="AbrirLink_Click"/>
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="Abrir o relatório completo" Tag="{Binding Relatorio}" Style="{StaticResource BotaoLink}" HorizontalAlignment="Left" Click="AbrirRelatorio_Click"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================= Otimizar ======================= -->
        <Grid x:Name="PaginaOtimizar" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ConteudoOtimizar" Margin="40,32,40,32" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                    <TextBlock Text="Otimizar o Windows" Style="{StaticResource TTitulo}"/>
                    <TextBlock Text="Ajustes seguros para o seu jeito de usar o PC. Tudo pode ser desfeito." Style="{StaticResource TCorpo}" FontSize="15" Margin="0,6,0,0"/>

                    <TextBlock Text="Como você usa o PC?" Style="{StaticResource TSecao}" FontSize="18"/>
                    <TextBlock Text="Escolha quantos quiser. O Zelo já marca o que recomenda para cada um." Style="{StaticResource TSuave}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="5" Margin="0,0,-10,0">
                            <ToggleButton x:Name="UsoJogos" Tag="Jogos" Style="{StaticResource CartaoAlternar}" Margin="0,0,10,0" Click="PerfilUso_Click" AutomationProperties.Name="Jogos">
                                <StackPanel>
                                    <TextBlock Text="Jogos" Style="{StaticResource TForte}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Mais desempenho, menos interrupção." Style="{StaticResource TSuave}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="UsoTrabalho" Tag="Trabalho" Style="{StaticResource CartaoAlternar}" Margin="0,0,10,0" Click="PerfilUso_Click" AutomationProperties.Name="Trabalho">
                                <StackPanel>
                                    <TextBlock Text="Trabalho" Style="{StaticResource TForte}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Foco e produtividade." Style="{StaticResource TSuave}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="UsoEstudos" Tag="Estudos" Style="{StaticResource CartaoAlternar}" Margin="0,0,10,0" Click="PerfilUso_Click" AutomationProperties.Name="Estudos">
                                <StackPanel>
                                    <TextBlock Text="Estudos" Style="{StaticResource TForte}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Leitura, anotações, menos distração." Style="{StaticResource TSuave}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="UsoEdicao" Tag="Edicao" Style="{StaticResource CartaoAlternar}" Margin="0,0,10,0" Click="PerfilUso_Click" AutomationProperties.Name="Edição e imagem">
                                <StackPanel>
                                    <TextBlock Text="Edição e imagem" Style="{StaticResource TForte}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Desempenho e ferramentas criativas." Style="{StaticResource TSuave}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="UsoDev" Tag="Dev" Style="{StaticResource CartaoAlternar}" Margin="0,0,10,0" Click="PerfilUso_Click" AutomationProperties.Name="Programação e Dev">
                                <StackPanel>
                                    <TextBlock Text="Programação e Dev" Style="{StaticResource TForte}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Ferramentas e ajustes de desenvolvedor." Style="{StaticResource TSuave}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                    </UniformGrid>

                    <Border Background="{StaticResource Ceu}" CornerRadius="10" Padding="16,12" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Aurora}" StrokeThickness="2" StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Data="M12,2 L20,5 L20,11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 L4,5 Z M8.5,12 L11,14.5 L15.5,9.5"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource TCorpo}" FontSize="13" Margin="12,0,0,0" TextWrapping="Wrap"
                                       Text="Antes de mudar qualquer coisa, o Zelo cria um ponto de restauração e anota como cada item estava, para desfazer um por um. Ele nunca desliga o Windows Update, o antivírus, o Firewall nem o Controle de Conta de Usuário, e não remove a Microsoft Store, o Edge nem partes do sistema."/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,22,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtOtimStatus" Style="{StaticResource TSuave}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        <ToggleButton x:Name="ChkTodosPerfis" Grid.Column="1" Style="{StaticResource Ficha}" Content="Mostrar os de outros perfis" Click="TodosPerfis_Click" Margin="0"/>
                    </Grid>

                    <ItemsControl x:Name="ListaOtimizacao">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TSecao}" FontSize="17"/>
                                    <TextBlock Text="{Binding Sub}" Visibility="{Binding VisSub}" Style="{StaticResource TSuave}" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource Cartao}" Padding="0">
                                        <ItemsControl ItemsSource="{Binding Itens}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource LinhaAjuste}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,16,0">
                                                                <TextBlock Text="{Binding Nome}" Style="{StaticResource TForte}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Descricao}" Style="{StaticResource TSuave}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Aviso}" Visibility="{Binding VisAviso}" FontSize="12.5" Foreground="{StaticResource Ambar}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                <Border Visibility="{Binding VisRisco}" Background="{StaticResource AmbarFundo}" CornerRadius="6" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding TextoRisco}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Ambar}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="1" Style="{StaticResource Interruptor}" IsChecked="{Binding Selecionado, Mode=TwoWay}" Visibility="{Binding VisInterruptor}"
                                                                      Click="AjusteOtim_Click" VerticalAlignment="Center" AutomationProperties.Name="{Binding Nome}"/>
                                                            <StackPanel Grid.Column="1" Visibility="{Binding VisEstado}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding TextoEstado}" FontSize="12.5" Foreground="{StaticResource Aurora}" HorizontalAlignment="Right"/>
                                                                <Button Content="{Binding TextoDesfazer}" Tag="{Binding Id}" Visibility="{Binding VisDesfazer}" Style="{StaticResource BotaoLink}"
                                                                        MinHeight="28" FontSize="12.5" HorizontalAlignment="Right" Click="DesfazerAjuste_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Background="{StaticResource Barra}" BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Padding="40,14">
                <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="TxtOtimResumo" Style="{StaticResource TForte}"/>
                        <TextBlock x:Name="TxtOtimProgresso" Style="{StaticResource TSuave}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnOtimDesfazerTudo" Grid.Column="1" Content="Desfazer tudo" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                            Visibility="Collapsed" Click="OtimDesfazerTudo_Click"/>
                    <Button x:Name="BtnOtimAplicar" Grid.Column="2" Content="Aplicar" Style="{StaticResource BotaoPrimario}" MinWidth="150" Click="OtimAplicar_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= Ajustes ======================= -->
        <ScrollViewer x:Name="PaginaAjustes" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="ConteudoAjustes" Margin="40,32,40,56" MaxWidth="860" HorizontalAlignment="Left">
                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ajustes" Style="{StaticResource TTitulo}"/>
                        <TextBlock Text="Cada mudança é salva na hora." Style="{StaticResource TCorpo}" FontSize="15" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSalvo" Grid.Column="1" VerticalAlignment="Bottom" FontSize="13" Foreground="{StaticResource Aurora}" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Right"/>
                </Grid>

                <!-- Quando -->
                <TextBlock Text="Quando o Zelo pode trabalhar" Style="{StaticResource TSecao}" FontSize="18"/>
                <UniformGrid Columns="3" Margin="0,0,-12,0">
                    <RadioButton x:Name="PerfilCasa" GroupName="perfil" Style="{StaticResource CartaoEscolha}" Margin="0,0,12,0" Checked="Perfil_Checked">
                        <StackPanel>
                            <TextBlock Text="Casa" Style="{StaticResource TForte}" FontSize="15"/>
                            <TextBlock Text="A qualquer hora, sempre que o PC estiver parado." Style="{StaticResource TSuave}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PerfilTrabalho" GroupName="perfil" Style="{StaticResource CartaoEscolha}" Margin="0,0,12,0" Checked="Perfil_Checked">
                        <StackPanel>
                            <TextBlock Text="Trabalho" Style="{StaticResource TForte}" FontSize="15"/>
                            <TextBlock Text="Fora do seu expediente, no horário que você escolher." Style="{StaticResource TSuave}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PerfilJogos" GroupName="perfil" Style="{StaticResource CartaoEscolha}" Margin="0,0,12,0" Checked="Perfil_Checked">
                        <StackPanel>
                            <TextBlock Text="Jogos" Style="{StaticResource TForte}" FontSize="15"/>
                            <TextBlock Text="De madrugada (2h às 8h), só com o PC bem parado." Style="{StaticResource TSuave}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <Border x:Name="PainelExpediente" Style="{StaticResource Cartao}" Padding="20" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Seu expediente" Style="{StaticResource TForte}" FontSize="15"/>
                        <TextBlock Text="O Zelo trabalha fora desse horário. Trabalha à noite? É só pôr, por exemplo, das 22h às 6h." Style="{StaticResource TSuave}" Margin="0,4,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Das" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtExpInicio" Width="80" TextAlignment="Center" LostFocus="Expediente_LostFocus" AutomationProperties.Name="Início do expediente"/>
                            <TextBlock Text="às" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtExpFim" Width="80" TextAlignment="Center" LostFocus="Expediente_LostFocus" AutomationProperties.Name="Fim do expediente"/>
                        </StackPanel>
                        <TextBlock Text="Dias de trabalho" Style="{StaticResource TRotulo}" Margin="0,18,0,8"/>
                        <WrapPanel x:Name="PainelDias">
                            <ToggleButton x:Name="Dia1" Content="Seg" Tag="1" Style="{StaticResource Ficha}" Click="Dia_Click"/>
                            <ToggleButton x:Name="Dia2" Content="Ter" Tag="2" Style="{StaticResource Ficha}" Click="Dia_Click"/>
                            <ToggleButton x:Name="Dia3" Content="Qua" Tag="3" Style="{StaticResource Ficha}" Click="Dia_Click"/>
                            <ToggleButton x:Name="Dia4" Content="Qui" Tag="4" Style="{StaticResource Ficha}" Click="Dia_Click"/>
                            <ToggleButton x:Name="Dia5" Content="Sex" Tag="5" Style="{StaticResource Ficha}" Click="Dia_Click"/>
                            <ToggleButton x:Name="Dia6" Content="Sáb" Tag="6" Style="{StaticResource Ficha}" Click="Dia_Click"/>
                            <ToggleButton x:Name="Dia0" Content="Dom" Tag="0" Style="{StaticResource Ficha}" Click="Dia_Click"/>
                        </WrapPanel>
                        <Border Background="{StaticResource Nuvem}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                            <TextBlock x:Name="TxtResumoExpediente" Style="{StaticResource TCorpo}" FontSize="13"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                    <Border Style="{StaticResource LinhaAjuste}">
                        <CheckBox x:Name="ChkOcioso" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                            <StackPanel>
                                <TextBlock Text="Esperar o PC ficar parado" Style="{StaticResource TForte}"/>
                                <TextBlock Text="Desligado, o Zelo começa assim que a vistoria vence, mesmo com você usando o PC (com prioridade baixa, para não atrapalhar). O horário do perfil continua valendo." Style="{StaticResource TSuave}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource LinhaAjuste}" BorderThickness="0">
                        <CheckBox x:Name="ChkTomada" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                            <StackPanel>
                                <TextBlock Text="Só com o carregador ligado" Style="{StaticResource TForte}"/>
                                <TextBlock Text="Em notebooks, para não gastar bateria." Style="{StaticResource TSuave}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <TextBlock x:Name="TituloBackup" Text="Backup" Style="{StaticResource TSecao}" FontSize="18"/>
                <Border Style="{StaticResource Cartao}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="O que copiar" Style="{StaticResource TForte}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <ItemsControl x:Name="ListaPastas">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Nuvem}" CornerRadius="8" Padding="12,0,4,0" MinHeight="36" Margin="0,0,8,8" ToolTip="{Binding Caminho}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" FontSize="13"/>
                                                <Button Content="×" Tag="{Binding Caminho}" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Suave}" MinHeight="30" Width="30" Padding="0" Margin="4,0,0,0"
                                                        Click="RemoverPasta_Click" AutomationProperties.Name="{Binding RotuloRemover}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Adicionar pasta" Style="{StaticResource BotaoSecundario}" MinHeight="36" FontSize="13" Padding="12,0" Foreground="{StaticResource Luar}" Margin="0,0,0,8" Click="AdicionarPasta_Click"/>
                        </WrapPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Onde guardar" Style="{StaticResource TForte}"/>
                                <TextBlock x:Name="TxtDestino" Style="{StaticResource TSuave}" Margin="0,2,16,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnDestino" Content="Escolher destino" Style="{StaticResource BotaoPrimario}" FontSize="14" VerticalAlignment="Center" Click="EscolherDestino_Click"/>
                        </Grid>
                        <Border Background="{StaticResource Ceu}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TSuave}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="Quando um arquivo muda, o Zelo guarda a versão anterior por 30 dias. Para recuperar, abra as versões: elas ficam em pastas com a data e a hora."/>
                                <Button Grid.Column="1" x:Name="BtnVersoes" Content="Abrir versões anteriores" Style="{StaticResource BotaoSecundario}" MinHeight="36" FontSize="13" Click="AbrirVersoes_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Limpeza -->
                <TextBlock Text="Limpeza" Style="{StaticResource TSecao}" FontSize="18" Margin="0,28,0,4"/>
                <TextBlock Text="O Zelo só apaga o que já tem idade: arquivos recentes nunca são tocados." Style="{StaticResource TSuave}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource Cartao}" Padding="0">
                    <StackPanel>
                        <Border Style="{StaticResource LinhaAjuste}">
                            <CheckBox x:Name="ChkTemp" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock x:Name="TxtTituloTemp" Text="Arquivos temporários antigos" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="Sobras de instalações e programas. Seguro." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LinhaAjuste}">
                            <CheckBox x:Name="ChkLixeira" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock x:Name="TxtTituloLixeira" Text="Lixeira antiga" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="O que você jogou fora há mais de um mês." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LinhaAjuste}">
                            <CheckBox x:Name="ChkCache" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock Text="Cache dos navegadores" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="Chrome, Edge, Firefox e Opera. Senhas e favoritos não são tocados; sites abrem um pouco mais devagar na primeira visita." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LinhaAjuste}" BorderThickness="0">
                            <CheckBox x:Name="ChkDownloads" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock x:Name="TxtTituloDownloads" Text="Pasta Downloads antiga" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="Apaga de vez o que está lá há muito tempo. Deixe desligado se você guarda coisas importantes nessa pasta." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Atualizações -->
                <TextBlock Text="Atualizações" Style="{StaticResource TSecao}" FontSize="18"/>
                <Border Style="{StaticResource Cartao}" Padding="0">
                    <StackPanel>
                        <Border Style="{StaticResource LinhaAjuste}">
                            <CheckBox x:Name="ChkWU" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock Text="Windows" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="Correções de segurança, com um ponto de restauração antes." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LinhaAjuste}">
                            <CheckBox x:Name="ChkWinget" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock Text="Programas instalados" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="Pelo gerenciador de pacotes do Windows (winget)." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LinhaAjuste}">
                            <CheckBox x:Name="ChkDrivers" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock Text="Drivers" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="Chipset, rede, áudio e USB. O de vídeo fica com o aplicativo da sua placa (NVIDIA, AMD ou Intel)." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LinhaAjuste}" BorderThickness="0">
                            <CheckBox x:Name="ChkAutoUpdate" Style="{StaticResource Interruptor}" Click="Ajuste_Click">
                                <StackPanel>
                                    <TextBlock Text="O próprio Zelo" Style="{StaticResource TForte}"/>
                                    <TextBlock Text="Instala sozinho as versões novas publicadas no GitHub." Style="{StaticResource TSuave}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Avançado -->
                <ToggleButton x:Name="BtnAvancado" Style="{StaticResource BotaoAlternar}" HorizontalAlignment="Left" Margin="0,24,0,0" Content="Mostrar opções avançadas" Click="Avancado_Click"/>
                <StackPanel x:Name="PainelAvancado" Visibility="Collapsed">
                    <Border Style="{StaticResource Cartao}" Padding="20" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Prazos e limites" Style="{StaticResource TForte}" FontSize="15" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Temporários: apagar a partir de quantos dias" VerticalAlignment="Center" Foreground="{StaticResource Texto2}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtDiasTemp" Width="80" Margin="0,4" TextAlignment="Center" LostFocus="Numero_LostFocus"/>
                                <TextBlock Grid.Row="1" Text="Lixeira: esvaziar itens com mais de quantos dias" VerticalAlignment="Center" Foreground="{StaticResource Texto2}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDiasLixeira" Width="80" Margin="0,4" TextAlignment="Center" LostFocus="Numero_LostFocus"/>
                                <TextBlock Grid.Row="2" Text="Downloads: apagar a partir de quantos dias" VerticalAlignment="Center" Foreground="{StaticResource Texto2}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDiasDownloads" Width="80" Margin="0,4" TextAlignment="Center" LostFocus="Numero_LostFocus"/>
                                <TextBlock Grid.Row="3" Text="Avisar quando um disco passar de (% em uso)" VerticalAlignment="Center" Foreground="{StaticResource Texto2}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtAvisoDisco" Width="80" Margin="0,4" TextAlignment="Center" LostFocus="Numero_LostFocus"/>
                                <TextBlock Grid.Row="4" Text="Avisar como urgente acima de (% em uso)" VerticalAlignment="Center" Foreground="{StaticResource Texto2}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtCriticoDisco" Width="80" Margin="0,4" TextAlignment="Center" LostFocus="Numero_LostFocus"/>
                                <TextBlock Grid.Row="5" Text="Considerar o PC parado com uso de processador abaixo de (%)" VerticalAlignment="Center" Foreground="{StaticResource Texto2}"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtCpu" Width="80" Margin="0,4" TextAlignment="Center" LostFocus="Numero_LostFocus"/>
                            </Grid>
                            <CheckBox x:Name="ChkRestauracao" Style="{StaticResource Interruptor}" Margin="0,16,0,0" Click="Ajuste_Click">
                                <TextBlock Text="Criar ponto de restauração antes das atualizações" Foreground="{StaticResource Texto}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="ChkDefenderCompleto" Style="{StaticResource Interruptor}" Margin="0,12,0,0" Click="Ajuste_Click">
                                <TextBlock Text="Verificação completa do antivírus no check-up mensal (pode levar horas)" Foreground="{StaticResource Texto}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Cartao}" Padding="20" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Cada verificação" Style="{StaticResource TForte}" FontSize="15"/>
                            <TextBlock Text="Desligue o que não fizer sentido para você. Itens desligados saem da nota de saúde." Style="{StaticResource TSuave}" Margin="0,4,0,8"/>
                            <ItemsControl x:Name="ListaTarefasConfig">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding Ativa, Mode=TwoWay}" Margin="0,8" Click="Ajuste_Click">
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Nome, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Texto}"/><Run Text="{Binding Rotinas, Mode=OneWay}" Foreground="{StaticResource Suave}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Descricao}" Style="{StaticResource TSuave}" FontSize="12"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sobre -->
                <TextBlock Text="Sobre" Style="{StaticResource TSecao}" FontSize="18" Margin="0,36,0,12"/>
                <Border Style="{StaticResource Cartao}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="Assets/zelo-256.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Style="{StaticResource TForte}" FontSize="16">
                                    <Hyperlink NavigateUri="https://github.com/xstargatewilliam/Zelo.App/releases" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource Texto}" TextDecorations="{x:Null}"
                                               ToolTip="Ver as versões no GitHub"><Run x:Name="TxtSobreVersao" Text="Zelo"/></Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource TCorpo}" Margin="0,2,0,0">
                                    <Run Text="Vigia o seu PC enquanto ele descansa. Criado por "/><Hyperlink NavigateUri="https://x.com/stargaterequiem" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource Luar}">William Stargate</Hyperlink><Run Text="."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource TSuave}" Margin="0,6,0,0">
                                    <Run Text="Código, novidades e versões:"/>
                                    <Hyperlink NavigateUri="https://github.com/xstargatewilliam/Zelo.App" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource Luar}">github.com/xstargatewilliam/Zelo.App</Hyperlink>
                                    <Run Text=" · Licença MIT."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtAtualizacao" Style="{StaticResource TSuave}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button x:Name="BtnAtualizar" Grid.Column="1" Content="Procurar atualização" Style="{StaticResource BotaoSecundario}" Click="Atualizar_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================= Detalhe de uma área ======================= -->
        <Grid x:Name="PainelArea" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="#D90B0F1A" MouseLeftButtonDown="FecharArea_Click"/>
            <Border Style="{StaticResource Cartao}" CornerRadius="16" Padding="0" MaxWidth="780" Margin="40,32" BorderBrush="{StaticResource LinhaForte}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="28,22,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconeAreaFundo" Width="40" Height="40" CornerRadius="12" VerticalAlignment="Top">
                            <Path x:Name="IconeArea" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                            <TextBlock x:Name="TxtAreaTitulo" Style="{StaticResource TForte}" FontSize="20"/>
                            <TextBlock x:Name="TxtAreaSub" Style="{StaticResource TSuave}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Fechar" Style="{StaticResource BotaoSecundario}" MinHeight="36" IsCancel="True" Click="FecharArea_Click" VerticalAlignment="Top"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Linha}"/>
                    <ScrollViewer x:Name="RolagemArea" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaVerificacoes" Margin="28,8,28,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="{Binding CorFundo}" VerticalAlignment="Top">
                                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Cor}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{Binding Icone}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Nome}" Style="{StaticResource TForte}" FontSize="15" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusTexto}" Foreground="{Binding Cor}" FontSize="12.5" FontWeight="SemiBold" Margin="12,2,0,0"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TCorpo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Quando}" Style="{StaticResource TSuave}" FontSize="12" Margin="0,4,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Acoes}" Visibility="{Binding VisAcoes}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Texto}" Tag="{Binding Id}" Style="{StaticResource BotaoSecundario}" MinHeight="36" FontSize="13" Padding="14,0" Margin="0,0,8,8" Click="AcaoPonto_Click"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Visibility="{Binding VisDetalhes}" Background="{StaticResource Barra}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                                                    <ItemsControl ItemsSource="{Binding Detalhes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding Texto, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                                             FontSize="12.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="1" Content="Abrir site" Tag="{Binding Link}" Visibility="{Binding VisLink}" Style="{StaticResource BotaoLink}"
                                                                            MinHeight="28" FontSize="12.5" Margin="8,0,0,0" Click="AbrirLink_Click"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= Boas-vindas ======================= -->
        <Grid x:Name="BoasVindas" Grid.ColumnSpan="2" Background="{StaticResource Noite}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Cartao}" CornerRadius="16" Padding="36,32" Width="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource LinhaForte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border x:Name="BvBarra1" Width="32" Height="4" CornerRadius="2" Background="{StaticResource Luar}" Margin="0,0,8,0"/>
                            <Border x:Name="BvBarra2" Width="32" Height="4" CornerRadius="2" Background="{StaticResource LinhaForte}" Margin="0,0,8,0"/>
                            <Border x:Name="BvBarra3" Width="32" Height="4" CornerRadius="2" Background="{StaticResource LinhaForte}"/>
                            <TextBlock x:Name="BvPassoTexto" Text="Passo 1 de 3" Style="{StaticResource TSuave}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="BvPasso1">
                            <Image Source="Assets/boas-vindas.png" Width="128" Height="128" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Oi! Eu cuido do seu PC enquanto ele descansa." Style="{StaticResource TTitulo}" Margin="0,16,0,8"/>
                            <TextBlock Text="Confiro discos, segurança e atualizações todo dia, e só chamo você quando algo precisar de atenção. Primeiro: quando posso trabalhar?" Style="{StaticResource TCorpo}" FontSize="15"/>
                            <StackPanel Margin="0,20,0,0">
                                <RadioButton x:Name="BvCasa" GroupName="bv" Style="{StaticResource CartaoEscolha}" Margin="0,0,0,10" IsChecked="True" Checked="BvPerfil_Checked">
                                    <StackPanel>
                                        <TextBlock Text="Uso em casa" Style="{StaticResource TForte}" FontSize="15"/>
                                        <TextBlock Text="A qualquer hora, quando o PC estiver parado." Style="{StaticResource TSuave}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="BvTrabalho" GroupName="bv" Style="{StaticResource CartaoEscolha}" Margin="0,0,0,10" Checked="BvPerfil_Checked">
                                    <StackPanel>
                                        <TextBlock Text="Uso para trabalho" Style="{StaticResource TForte}" FontSize="15"/>
                                        <TextBlock Text="Só fora do seu expediente." Style="{StaticResource TSuave}"/>
                                    </StackPanel>
                                </RadioButton>
                                <StackPanel x:Name="BvPainelExpediente" Visibility="Collapsed" Margin="18,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Meu expediente é das" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="BvExpInicio" Width="72" TextAlignment="Center" Text="9h" AutomationProperties.Name="Início do expediente"/>
                                        <TextBlock Text="às" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBox x:Name="BvExpFim" Width="72" TextAlignment="Center" Text="18h" AutomationProperties.Name="Fim do expediente"/>
                                    </StackPanel>
                                    <TextBlock Text="De segunda a sexta. Trabalha à noite? Ponha, por exemplo, das 22h às 6h. Os dias você muda depois em Ajustes." Style="{StaticResource TSuave}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <RadioButton x:Name="BvJogos" GroupName="bv" Style="{StaticResource CartaoEscolha}" Checked="BvPerfil_Checked">
                                    <StackPanel>
                                        <TextBlock Text="Jogos" Style="{StaticResource TForte}" FontSize="15"/>
                                        <TextBlock Text="De madrugada, com o PC bem parado." Style="{StaticResource TSuave}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="BvPasso2" Visibility="Collapsed">
                            <TextBlock Text="Seus arquivos merecem uma cópia." Style="{StaticResource TTitulo}" Margin="0,0,0,8"/>
                            <TextBlock Text="Se um disco falhar, fotos e documentos se perdem. Escolha as pastas importantes e um lugar para guardar a cópia — o ideal é um disco externo ou uma pasta do OneDrive ou Google Drive." Style="{StaticResource TCorpo}" FontSize="15"/>
                            <TextBlock Text="O que copiar" Style="{StaticResource TForte}" Margin="0,20,0,8"/>
                            <ItemsControl x:Name="BvListaPastas">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Nuvem}" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding Nome}" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Adicionar pastas" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Left" Foreground="{StaticResource Luar}" Click="AdicionarPasta_Click"/>
                            <TextBlock Text="Onde guardar" Style="{StaticResource TForte}" Margin="0,20,0,4"/>
                            <TextBlock x:Name="BvTxtDestino" Style="{StaticResource TSuave}" Margin="0,0,0,8"/>
                            <Button Content="Escolher destino" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Left" Click="EscolherDestino_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="BvPasso3" Visibility="Collapsed">
                            <TextBlock Text="Tudo pronto." Style="{StaticResource TTitulo}" Margin="0,0,0,8"/>
                            <TextBlock Text="Para começar, que tal ver o que eu faria no seu PC? A simulação só mostra; não muda nada." Style="{StaticResource TCorpo}" FontSize="15"/>
                            <TextBlock Text="Depois disso, eu sigo sozinho: vistoria todo dia, revisão toda semana e um check-up por mês. Você pode mudar tudo em Ajustes." Style="{StaticResource TSuave}" Margin="0,12,0,0"/>
                            <TextBlock Text="O que eu posso instalar sozinho?" Style="{StaticResource TForte}" FontSize="15" Margin="0,20,0,4"/>
                            <TextBlock Text="Você decide agora. Se mudar algo, o Windows pede a sua confirmação de administrador." Style="{StaticResource TSuave}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Border Style="{StaticResource Cartao}" Padding="0">
                                <StackPanel>
                                    <Border Style="{StaticResource LinhaAjuste}">
                                        <CheckBox x:Name="BvWU" Style="{StaticResource Interruptor}">
                                            <StackPanel>
                                                <TextBlock Text="Atualizações do Windows" Style="{StaticResource TForte}"/>
                                                <TextBlock Text="Correções de segurança e qualidade, sem trocar a versão do Windows. Recomendado." Style="{StaticResource TSuave}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource LinhaAjuste}">
                                        <CheckBox x:Name="BvWinget" Style="{StaticResource Interruptor}">
                                            <StackPanel>
                                                <TextBlock Text="Atualizar os seus programas" Style="{StaticResource TForte}"/>
                                                <TextBlock Text="Navegadores, leitores de PDF, compactadores… pelo gerenciador oficial do Windows (winget)." Style="{StaticResource TSuave}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource LinhaAjuste}">
                                        <CheckBox x:Name="BvDrivers" Style="{StaticResource Interruptor}">
                                            <StackPanel>
                                                <TextBlock Text="Drivers pelo Windows Update" Style="{StaticResource TForte}"/>
                                                <TextBlock Text="Exceto os de vídeo. Desligado por padrão: em alguns PCs, o driver do fabricante é melhor." Style="{StaticResource TSuave}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource LinhaAjuste}" BorderThickness="0">
                                        <CheckBox x:Name="BvAutoUpdate" Style="{StaticResource Interruptor}">
                                            <StackPanel>
                                                <TextBlock Text="Novas versões do Zelo" Style="{StaticResource TForte}"/>
                                                <TextBlock Text="Só o pacote oficial do GitHub, conferido antes de instalar." Style="{StaticResource TSuave}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BvVoltar" Content="Fazer isso depois" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Texto2}" Click="BvVoltar_Click"/>
                            <TextBlock x:Name="BvErro" Grid.Column="1" Style="{StaticResource TSuave}" Foreground="{StaticResource Coral}" VerticalAlignment="Center" Margin="12,0"/>
                            <Button x:Name="BvAvancar" Grid.Column="2" Content="Continuar" Style="{StaticResource BotaoPrimario}" Padding="24,0" Click="BvAvancar_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
