<Window x:Class="Zelo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zelo — Manutenção do Windows"
        Width="1100" Height="780" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fundo}"
        Foreground="{StaticResource Texto}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Cabeçalho ===================== -->
        <Border Grid.Row="0" Background="{StaticResource Cartao}" BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1">
            <Grid Margin="32,24,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Anel do score -->
                <Grid Grid.Column="0" Width="128" Height="128" Margin="0,0,28,0">
                    <Ellipse Stroke="{StaticResource Linha}" StrokeThickness="11"/>
                    <Path x:Name="Arco" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource Destaque}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtScore" Text="—" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="saúde" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Textos -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Text="Conectando ao serviço..." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource Rotulo}" FontSize="14" Margin="0,4,0,12"/>
                    <TextBlock x:Name="TxtDiaria" Style="{StaticResource Rotulo}" Margin="0,1"/>
                    <TextBlock x:Name="TxtSemanal" Style="{StaticResource Rotulo}" Margin="0,1"/>
                    <TextBlock x:Name="TxtMensal" Style="{StaticResource Rotulo}" Margin="0,1"/>
                </StackPanel>

                <!-- Ações -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="230" Margin="24,0,0,0">
                    <TextBlock Text="Executar agora" Style="{StaticResource Rotulo}" Margin="0,0,0,6"/>
                    <UniformGrid Columns="3" x:Name="PainelBotoes">
                        <Button x:Name="BtnDiaria" Content="Diária" Style="{StaticResource Botao}" Margin="0,0,4,0" Padding="6,8" Click="Executar_Click" Tag="Diaria"/>
                        <Button x:Name="BtnSemanal" Content="Semanal" Style="{StaticResource BotaoSecundario}" Margin="2,0" Padding="6,8" Click="Executar_Click" Tag="Semanal"/>
                        <Button x:Name="BtnMensal" Content="Mensal" Style="{StaticResource BotaoSecundario}" Margin="4,0,0,0" Padding="6,8" Click="Executar_Click" Tag="Mensal"/>
                    </UniformGrid>
                    <CheckBox x:Name="ChkSimulacao" Content="Modo simulação (não altera nada)" Margin="0,10,0,0"
                              ToolTip="Mostra o que cada tarefa faria, sem apagar, instalar ou alterar nada."/>
                    <StackPanel x:Name="PainelProgresso" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtProgresso" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="BarraProgresso" Height="6" Margin="0,6" Foreground="{StaticResource Destaque}" Background="{StaticResource Linha}" BorderThickness="0"/>
                        <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}" Padding="10,4" HorizontalAlignment="Left" Click="Cancelar_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Abas -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,22,0,0">
                    <RadioButton x:Name="AbaGeral" Content="Visão geral" Style="{StaticResource Aba}" IsChecked="True" Checked="Aba_Checked"/>
                    <RadioButton x:Name="AbaHistorico" Content="Histórico" Style="{StaticResource Aba}" Checked="Aba_Checked"/>
                    <RadioButton x:Name="AbaConfig" Content="Configurações" Style="{StaticResource Aba}" Checked="Aba_Checked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso de serviço fora do ar -->
        <Border Grid.Row="1" x:Name="BannerServico" Visibility="Collapsed" Background="{StaticResource PerigoClaro}" Padding="32,10">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Perigo}">
                <Run FontWeight="SemiBold" Text="O serviço do Zelo não está respondendo."/>
                <Run Text="Confira se ele foi instalado e está em execução (Win + R → services.msc → Zelo). O painel tenta reconectar sozinho."/>
            </TextBlock>
        </Border>

        <!-- ===================== Visão geral ===================== -->
        <ScrollViewer Grid.Row="2" x:Name="PainelGeral" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,8,32,32">

                <ItemsControl x:Name="ListaCategorias" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CartaoBorda}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nome}" Style="{StaticResource Rotulo}"/>
                                    <TextBlock Text="{Binding ValorTexto}" FontSize="30" FontWeight="Bold" Foreground="{Binding Cor}" Margin="0,2,0,6"/>
                                    <ProgressBar Value="{Binding Valor, Mode=OneWay}" Maximum="100" Height="5" BorderThickness="0"
                                                 Foreground="{Binding Cor}" Background="{StaticResource Linha}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="TituloAlertas" Text="Precisa de atenção" Style="{StaticResource Titulo}"/>
                <TextBlock x:Name="TxtSemAlertas" Text="Nada pendente. Tudo em ordem por aqui." Style="{StaticResource Rotulo}" Visibility="Collapsed"/>
                <ItemsControl x:Name="ListaAlertas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Cartao}" BorderBrush="{StaticResource Linha}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Cor}" CornerRadius="8,0,0,8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Texto}" TextWrapping="Wrap" Margin="14,10"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,24,0,10">
                    <Button DockPanel.Dock="Right" x:Name="BtnRelatorio" Content="Abrir relatório completo" Style="{StaticResource BotaoSecundario}"
                            Padding="12,6" Click="AbrirRelatorio_Click" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Última execução" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUltimaExecucao" Style="{StaticResource Rotulo}"/>
                    </StackPanel>
                </DockPanel>

                <ItemsControl x:Name="ListaResultados">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CartaoBorda}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Background="{Binding Cor}" CornerRadius="10" Padding="9,1" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusTexto}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Duracao}" Style="{StaticResource Rotulo}" Margin="12,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Expander Header="Detalhes" Visibility="{Binding VisDetalhes}" Margin="0,8,0,0" Foreground="{StaticResource Suave}">
                                        <TextBox Text="{Binding Detalhes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                 Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                                 Foreground="{StaticResource Suave}" Margin="0,6,0,0"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Histórico ===================== -->
        <Grid Grid.Row="2" x:Name="PainelHistorico" Visibility="Collapsed" Margin="32,8,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Score de saúde ao longo do tempo" Style="{StaticResource Titulo}"/>
            <Border Grid.Row="1" Style="{StaticResource CartaoBorda}" Height="190">
                <Grid>
                    <Canvas x:Name="Grafico" ClipToBounds="True" SizeChanged="Grafico_SizeChanged"/>
                    <TextBlock x:Name="TxtGraficoVazio" Text="O gráfico aparece depois das primeiras execuções." Style="{StaticResource Rotulo}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="Execuções (dê dois cliques para abrir o relatório)" Style="{StaticResource Titulo}"/>
            <DataGrid Grid.Row="3" x:Name="GradeHistorico" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Linha}"
                      Background="{StaticResource Cartao}" BorderBrush="{StaticResource Linha}" RowHeight="34"
                      SelectionMode="Single" MouseDoubleClick="GradeHistorico_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="150"/>
                    <DataGridTextColumn Header="Rotina" Binding="{Binding Rotina}" Width="100"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="140"/>
                    <DataGridTemplateColumn Header="Resultado" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Resultado}" Foreground="{Binding Cor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="80"/>
                    <DataGridTextColumn Header="Duração" Binding="{Binding Duracao}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ===================== Configurações ===================== -->
        <ScrollViewer Grid.Row="2" x:Name="PainelConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,8,32,32" MaxWidth="780" HorizontalAlignment="Left">

                <TextBlock Text="Perfil de uso" Style="{StaticResource Titulo}"/>
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <ComboBox x:Name="CmbPerfil" Width="260" HorizontalAlignment="Left" SelectionChanged="CmbPerfil_SelectionChanged">
                            <ComboBoxItem Content="PC doméstico (qualquer horário, quando ocioso)" Tag="Domestico"/>
                            <ComboBoxItem Content="Trabalho (fora do expediente, 19h às 7h)" Tag="Trabalho"/>
                            <ComboBoxItem Content="Jogos (madrugada, só com o PC parado)" Tag="Jogos"/>
                        </ComboBox>
                        <TextBlock Text="Escolher um perfil ajusta os horários abaixo. Você ainda pode mudar cada item." Style="{StaticResource Rotulo}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Quando rodar" Style="{StaticResource Titulo}"/>
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Das" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbHoraInicio" Width="80"/>
                            <TextBlock Text="às" VerticalAlignment="Center" Margin="8,0"/>
                            <ComboBox x:Name="CmbHoraFim" Width="80"/>
                            <TextBlock Text="(00h às 24h = qualquer horário)" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Considerar o PC ocioso com CPU abaixo de" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtCpu" Width="56"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkTomada" Content="Em notebooks, só rodar com o carregador conectado" Margin="0,12,0,0"/>
                        <TextBlock Text="Se uma rotina ficar mais de 48h atrasada (PC sempre em uso no horário), ela roda na próxima chance, mesmo fora da janela."
                                   Style="{StaticResource Rotulo}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Backup" Style="{StaticResource Titulo}"/>
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="Pastas para copiar (uma por linha)"/>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Adicionar pasta..." Style="{StaticResource BotaoSecundario}" Padding="10,6" Margin="8,0,0,0"
                                    VerticalAlignment="Top" Click="AdicionarPasta_Click"/>
                            <TextBox x:Name="TxtPastas" AcceptsReturn="True" Height="96" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                        <TextBlock Text="Destino (de preferência um disco externo ou pasta de rede)" Margin="0,14,0,0"/>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Escolher..." Style="{StaticResource BotaoSecundario}" Padding="10,6" Margin="8,0,0,0"
                                    Click="EscolherDestino_Click"/>
                            <TextBox x:Name="TxtDestino"/>
                        </DockPanel>
                        <TextBlock Text="O backup só acrescenta e atualiza arquivos no destino; nada é apagado lá. Os arquivos ficam na pasta Zelo-Backup."
                                   Style="{StaticResource Rotulo}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Limpeza e disco" Style="{StaticResource Titulo}"/>
                <Border Style="{StaticResource CartaoBorda}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Apagar arquivos temporários com mais de (dias)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtDiasTemp" Width="70" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="Esvaziar itens da Lixeira com mais de (dias)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDiasLixeira" Width="70" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="Avisar quando um disco passar de (% em uso)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtAvisoDisco" Width="70" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Text="Alerta crítico acima de (% em uso)" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtCriticoDisco" Width="70" Margin="0,4"/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="ChkCache"
                                  Content="Limpar cache do Chrome, Edge, Firefox e Opera/Opera GX toda semana (sites podem carregar mais devagar na primeira visita)"/>
                        <CheckBox Grid.Row="5" x:Name="ChkDownloads" VerticalAlignment="Center"
                                  Content="Apagar arquivos da pasta Downloads com mais de (dias) — exclusão definitiva, não vai para a Lixeira"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtDiasDownloads" Width="70" Margin="0,4"/>
                    </Grid>
                </Border>

                <TextBlock Text="Atualizações e segurança" Style="{StaticResource Titulo}"/>
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <CheckBox x:Name="ChkWU" Content="Instalar atualizações do Windows automaticamente (semanal)"/>
                        <CheckBox x:Name="ChkWinget" Content="Atualizar programas instalados com o winget (semanal)"/>
                        <CheckBox x:Name="ChkDrivers" Content="Instalar drivers pelo Windows Update (semanal; drivers de vídeo ficam com o software do fabricante)"/>
                        <CheckBox x:Name="ChkRestauracao" Content="Criar ponto de restauração antes das atualizações"/>
                        <CheckBox x:Name="ChkDefenderCompleto" Content="Verificação completa do antivírus (mensal, pode levar horas)"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Tarefas" Style="{StaticResource Titulo}"/>
                <Border Style="{StaticResource CartaoBorda}">
                    <ItemsControl x:Name="ListaTarefasConfig">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Ativa, Mode=TwoWay}" ToolTip="{Binding Descricao}">
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Nome, Mode=OneWay}"/>
                                            <Run Text="{Binding Rotinas, Mode=OneWay}" Foreground="{StaticResource Suave}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Descricao}" Style="{StaticResource Rotulo}" FontSize="12"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Salvar configurações" Style="{StaticResource Botao}" Click="SalvarConfig_Click"/>
                    <Button Content="Descartar alterações" Style="{StaticResource BotaoSecundario}" Margin="10,0,0,0" Click="RecarregarConfig_Click"/>
                    <TextBlock x:Name="TxtStatusConfig" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource Rotulo}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
